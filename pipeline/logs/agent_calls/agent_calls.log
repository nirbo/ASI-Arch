d>", "usage": "<max_depth_reached>"}, "_last_agent": {"name": "<max_depth_reached>", "instructions": "<max_depth_reached>", "handoff_description": "<max_depth_reached>", "handoffs": "<max_depth_reached>", "model": "<max_depth_reached>", "model_settings": "<max_depth_reached>", "tools": "<max_depth_reached>", "mcp_servers": "<max_depth_reached>", "mcp_config": "<max_depth_reached>", "input_guardrails": "<max_depth_reached>", "output_guardrails": "<max_depth_reached>", "output_type": "<max_depth_reached>", "hooks": "<max_depth_reached>", "tool_use_behavior": "<max_depth_reached>", "reset_tool_choice": "<max_depth_reached>"}}}, "pipeline_id": "pipeline_20250807_180433_747052_experiment", "usage": {"input_tokens": 3134, "output_tokens": 33, "total_tokens": 3167}}
